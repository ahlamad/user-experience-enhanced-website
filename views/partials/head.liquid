<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Milledoni</title>
    <link rel="stylesheet" href="styles/styleguide-milledoni.css">
    <link rel="stylesheet" href="styles/style.css">
    <script src="/scripts/script.js" defer></script>
  </head>

  <body>
    <header>
      <nav class="nav">
        
        <a href="/" class="logo">
          <img src="/assets/mobile-logo.svg" alt="Milledoni home" width="50" height="50">
        </a>

        <form method="GET" action="/" class="search-bar">
          
            <label for="search" class="visually-hidden">Search</label>
            <input
              type="search"
              id="search"
              name="search"
              placeholder="Zoek jouw cadeau"
            >
            <p class="search-description"><span>Describe the person</span> you're getting a gift for, or the <span>specific need</span> you're looking to meet with a gift</p>
       
        </form>

        <a href="/lijsten" class="lijsten">
            <img src="/assets/lijst.svg" alt="Opgeslagen lijsten" width="35" height="35">
              <span class="liked-count">{{ likedCount }}</span>
        </a>
    </nav>
  </header>